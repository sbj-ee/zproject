#!/bin/sh
# zprojectd prerm: stop the units on removal (not on upgrade).
set -e
if [ "$1" = "remove" ] && [ -d /run/systemd/system ]; then
  systemctl stop zprojectd-backup.timer zprojectd.service >/dev/null 2>&1 || true
  systemctl disable zprojectd-backup.timer zprojectd.service >/dev/null 2>&1 || true
fi
exit 0
