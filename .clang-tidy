# Static analysis for zproject's own code (core/, store/, server/, app/, cli/);
# CI job "clang-tidy" fails on any finding. Run it locally with:
#   cmake -B build -G Ninja && cmake --build build   # moc output, version.hpp
#   run-clang-tidy -quiet -p build "$PWD/(core|store|server|app|cli)/.*\.cpp$"
# Same check set as zterminal. Switched off below: checks that only produce
# noise with Qt code. Each has a reason; re-enable one by deleting its line and
# fixing what it reports.
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  -cert-err58-cpp,
  -clang-analyzer-cplusplus.NewDelete,
  -clang-analyzer-cplusplus.NewDeleteLeaks,
  -clang-analyzer-optin.performance.Padding
# easily-swappable-parameters   style opinion; flags most (int, int) signatures
# exception-escape              Qt code is not exception-safe by design
# cert-err58-cpp                every file-scope QString/QStringList constant
# cplusplus.NewDelete, NewDeleteLeaks
#                               false reports inside Qt's headers with
#                               clang-tidy 18; ASan/LSan in CI cover the real thing
# performance.Padding           struct layout advice, not a defect
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/(core|store|server|app|cli)/[^/]*$'
